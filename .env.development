# Committed on purpose: these are the well-known Supabase CLI local-dev
# defaults (same for every project using the default config.toml jwt_secret),
# never valid against a real hosted project. `npm run dev` uses this file
# automatically (Vite mode-based env loading) — no manual setup required
# after `supabase start`. See docs/RUNBOOK.md and .env.example for the
# production counterpart (`.env.production`, gitignored).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_ENV_LABEL=local
