# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). Only the anon/publishable key belongs
# here — NEVER the service_role key: everything in this file is shipped to the
# browser. Row Level Security is what protects per-user data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
